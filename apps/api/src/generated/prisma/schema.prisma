generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============= ENUMS =============

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ProjectRole {
  OWNER // создатель проекта, полные права
  ADMIN // может управлять задачами и участниками
  MEMBER // обычный участник
}

// ============= МОДЕЛИ =============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatar       String? // URL аватарки (опционально)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Отношения
  ownedProjects Project[]       @relation("Owner") // проекты, где пользователь владелец
  memberOf      ProjectMember[] // членство в проектах
  assignedTasks Task[]          @relation("Assignee") // задачи, назначенные на пользователя
  taskComments  TaskComment[] // комментарии к задачам
  chatMessages  ChatMessage[] // сообщения в чате

  @@index([email])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String // внешний ключ на пользователя-владельца
  owner   User   @relation("Owner", fields: [ownerId], references: [id], onDelete: Cascade)

  members      ProjectMember[] // участники проекта
  tasks        Task[] // задачи проекта
  chatMessages ChatMessage[] // сообщения в чате проекта

  @@index([ownerId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // уникальная пара (projectId, userId), чтобы нельзя было добавить одного пользователя дважды
  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  deadline    DateTime? // опциональный дедлайн
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String? // может быть не назначена
  assignee   User?   @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments TaskComment[] // комментарии к задаче

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String // текст комментария
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

// Модель для чата проекта (сообщения в реальном времени)
model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([authorId])
}
